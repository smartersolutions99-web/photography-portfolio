# ============================================================
#  Backend okruzenje — kopiraj u  backend/.env  i popuni
#  (.env se NE komituje u git)
# ============================================================

# --- Supabase Postgres ---------------------------------------
# Uzmi "Session pooler" connection string iz Supabase:
#   Project Settings -> Database -> Connection string -> "Session pooler" (JDBC)
# Host je oblika: aws-0-<region>.pooler.supabase.com , port 5432
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.xxxxxxxxxxxxxxxxxxxx
SPRING_DATASOURCE_PASSWORD=your-db-password

# --- Cloudflare R2 (S3-kompatibilno) -------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=fotograf-portfolio
# Javni URL bucketa (r2.dev ili custom domen), BEZ zavrsne kose crte:
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxx.r2.dev

# --- Autentikacija (jedan admin) -----------------------------
# Dovoljno je postaviti ADMIN_USERNAME + ADMIN_PASSWORD (raw).
# App ce lozinku hesirati na startu. (Alternativno postavi ADMIN_PASSWORD_HASH.)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=promeni-me
ADMIN_PASSWORD_HASH=

# JWT tajni kljuc — nasumican string, minimum 32 karaktera:
JWT_SECRET=zameni-ovo-dugackim-nasumicnim-tajnim-kljucem-min-32

# --- CORS ----------------------------------------------------
APP_CORS_ORIGINS=http://localhost:3000
