# URL backend API-ja (Spring Boot)
# Lokalno: http://localhost:8080
# Produkcija (Render): https://photography-portfolio-5pp5.onrender.com
#   -> na Vercel-u postaviti kao Config (ne Secret) i redeploy-ovati.
#   -> Render free tier "spava": prvi zahtjev nakon neaktivnosti je spor (~90s cold start).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Javni URL sajta — za kanonske linkove, sitemap.xml, robots.txt i Open Graph.
# Na Vercel-u postaviti na produkcijski domen, npr. https://studio.vercel.app
# (bez trailing slash-a). Ako se ne postavi, koristi http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
